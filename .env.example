# [gemini|claude]
DAIS_LLM_PROVIDER=

# Gemini
DAIS_GEMINI_API_KEY=

# Claude
DAIS_CLAUDE_API_KEY=

# Security
DAIS_ALLOWED_ORIGINS='["http://localhost:3000"]'

# Optional shared API key. Must match NEXT_PUBLIC_API_KEY baked into the frontend build.
# Leave empty to disable API key protection.
DAIS_API_KEY=